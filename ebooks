<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0b0b10;
    --ink2:#131320;
    --ink3:#191928;
    --line:rgba(255,255,255,.12);
    --text:#f3f3f7;
    --muted:#9a97ab;
    --fucsia:#ff006e;
    --violeta:#7c3aed;
    --cyan:#00d4ff;
    --grad: linear-gradient(90deg,var(--fucsia),var(--violeta),var(--cyan));
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  :root:not([data-theme="light"]){ color-scheme:dark; }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){ --ink:#0b0b10; --text:#f3f3f7; }
  }
  :root[data-theme="dark"]{ --ink:#0b0b10; --text:#f3f3f7; }
  html{ scroll-padding-top:env(safe-area-inset-top,0px); scroll-behavior:smooth; }
  *{margin:0;box-sizing:border-box}
  body{
    background:var(--ink);
    color:var(--text);
    font-family:'Jost',sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{max-width:100%;display:block}
  a{color:inherit}
  h1,h2,h3,h4{font-family:'Cormorant Garamond',Georgia,serif;font-weight:700;line-height:1.05}
  .wrap{max-width:1080px;margin:0 auto;padding:0 24px}
  .rule{height:2px;width:64px;background:var(--grad);border-radius:2px}
  .eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);font-weight:600}
  .gradiente{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  section{position:relative;overflow-x:clip}

  /* ---------- NAV ---------- */
  nav{position:sticky;top:0;z-index:20;background:rgba(11,11,16,.82);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
  nav .row{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;max-width:1080px;margin:0 auto}
  .brand{font-size:13px;letter-spacing:.1em;font-weight:600}
  .brand b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
  .nav-cta{font-size:13px;font-weight:600;padding:9px 18px;border-radius:100px;background:var(--grad);color:#fff;text-decoration:none;white-space:nowrap}

  /* ---------- HERO ---------- */
  .hero{padding:88px 0 72px;text-align:center}
  .hero-glow{position:absolute;top:-160px;left:50%;transform:translateX(-50%);width:900px;height:520px;background:radial-gradient(circle,rgba(255,0,110,.22),rgba(124,58,237,.14) 45%,transparent 72%);pointer-events:none;z-index:0}
  .hero>*{position:relative;z-index:1}
  .hero .eyebrow{display:block;margin-bottom:22px}
  .hero h1{font-size:clamp(34px,6vw,58px);max-width:820px;margin:0 auto}
  .hero p.lead{max-width:560px;margin:22px auto 0;color:var(--muted);font-size:17px;line-height:1.6}
  .hero-ctas{margin-top:34px;display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  .btn{display:inline-block;padding:15px 30px;border-radius:100px;font-weight:600;font-size:15px;text-decoration:none;letter-spacing:.01em}
  .btn-grad{background:var(--grad);color:#fff}
  .btn-ghost{border:1px solid var(--line);color:var(--text)}
  .hero-note{margin-top:16px;color:var(--muted);font-size:12.5px}

  /* mini stacked covers */
  .stack{margin:56px auto 0;display:flex;justify-content:center;gap:-20px;perspective:1000px}
  .mini-cover{width:132px;height:186px;border-radius:8px;padding:16px 14px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 20px 40px rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.14)}
  .mini-cover:nth-child(1){transform:rotate(-9deg) translateX(18px);background:radial-gradient(circle at 30% 20%,#3a0a22,#0b0b10 70%)}
  .mini-cover:nth-child(2){transform:translateY(-10px);z-index:2;background:radial-gradient(circle at 30% 20%,#2a1147,#0b0b10 70%)}
  .mini-cover:nth-child(3){transform:rotate(9deg) translateX(-18px);background:radial-gradient(circle at 30% 20%,#062633,#0b0b10 70%)}
  .mini-cover .mc-eyebrow{font-size:6.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--cyan);font-weight:600}
  .mini-cover .mc-title{font-family:'Cormorant Garamond',serif;font-weight:700;font-size:15px;line-height:1.08;color:#fff}
  .mini-cover .mc-rule{height:1.5px;width:26px;background:var(--grad)}

  /* ---------- SECTION HEADINGS ---------- */
  .sec-head{max-width:600px;margin:0 auto 44px;text-align:center}
  .sec-head h2{font-size:clamp(26px,4vw,36px);margin-top:16px}
  .sec-head p{color:var(--muted);margin-top:12px;font-size:15.5px}

  /* ---------- INCLUDES ---------- */
  .includes{padding:96px 0 40px}
  .cards3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .card{background:var(--ink2);border:1px solid var(--line);border-radius:16px;padding:26px}
  .card .tag{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--fucsia);font-weight:600}
  .card h3{font-size:22px;margin-top:10px;color:#fff}
  .card p{color:var(--muted);font-size:14px;margin-top:10px;line-height:1.55}
  .card .meta{margin-top:16px;font-size:12px;color:var(--muted);border-top:1px solid var(--line);padding-top:14px}

  .bonos{margin-top:22px;background:linear-gradient(135deg,rgba(255,0,110,.10),rgba(124,58,237,.09),rgba(0,212,255,.08));border:1px solid var(--line);border-radius:16px;padding:26px 28px}
  .bonos h4{font-size:19px;color:#fff;font-weight:700;font-family:'Jost',sans-serif}
  .bonos-grid{margin-top:20px;display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
  .bonos-col-title{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--cyan);font-weight:600;border-bottom:1px solid var(--line);padding-bottom:8px;margin-bottom:10px}
  .bonos-col ul{list-style:none;padding:0;display:grid;gap:8px}
  .bonos-col li{font-size:12.5px;color:var(--text);display:flex;gap:8px;align-items:flex-start;line-height:1.4}
  .bonos-col li:before{content:"";width:5px;height:5px;border-radius:50%;background:var(--fucsia);margin-top:6px;flex-shrink:0}

  /* ---------- PRICING ---------- */
  .pricing{padding:80px 0}
  .price-card{max-width:640px;margin:0 auto;background:var(--ink2);border:1px solid rgba(255,0,110,.4);border-radius:20px;padding:42px 40px;text-align:center;position:relative}
  .price-card:before{content:"Oferta de lanzamiento";position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--grad);color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:6px 16px;border-radius:100px;font-weight:600}
  .price-card h3{font-size:28px;color:#fff;margin-top:6px}
  .price-row{margin:22px 0 6px;display:flex;align-items:baseline;justify-content:center;gap:12px;flex-wrap:wrap}
  .price-now{font-size:44px;font-weight:700;font-family:'Cormorant Garamond',serif;color:#fff}
  .price-was{font-size:18px;color:var(--muted);text-decoration:line-through}
  .price-save{font-size:12.5px;color:var(--cyan);font-weight:600;letter-spacing:.02em}
  .price-card .btn{margin-top:26px;width:100%}
  .price-list{margin-top:28px;text-align:left;list-style:none;padding:0;display:grid;gap:12px}
  .price-list li{font-size:13.5px;color:var(--muted);line-height:1.5;position:relative;padding-left:24px}
  .price-list li:before{content:"✓";color:var(--cyan);font-weight:700;position:absolute;left:0;top:0}
  .price-list li.destacado{background:rgba(0,212,255,.07);border:1px solid rgba(0,212,255,.3);border-radius:10px;padding:12px 14px 12px 34px}
  .price-list li.destacado:before{left:12px}
  .price-list .wa-quote{display:block;margin-top:6px;font-style:italic;color:var(--text);font-size:12.5px;line-height:1.5}
  .price-fine{margin-top:20px;font-size:11.5px;color:var(--muted)}

  /* ---------- INDIVIDUAL ---------- */
  .individual{padding:20px 0 90px}
  .ind-row{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .ind-card{border:1px solid var(--line);border-radius:14px;padding:22px;display:flex;flex-direction:column}
  .ind-wa{margin-top:10px;font-size:11px;color:var(--cyan)}
  .ind-card h4{font-size:18px;color:#fff;font-family:'Cormorant Garamond',serif}
  .ind-card p{color:var(--muted);font-size:13px;margin-top:8px;flex-grow:1}
  .ind-foot{display:flex;align-items:center;justify-content:space-between;margin-top:18px;padding-top:14px;border-top:1px solid var(--line)}
  .ind-price{font-size:17px;font-weight:600;color:#fff}
  .ind-link{font-size:12.5px;font-weight:600;color:var(--cyan);text-decoration:none;border:1px solid rgba(0,212,255,.4);padding:8px 14px;border-radius:100px}

  /* ---------- HISTORIA (foto + frase) ---------- */
  .historia{padding:90px 0;border-top:1px solid var(--line);position:relative;overflow:hidden}
  .historia-glow{position:absolute;top:-120px;right:-160px;width:520px;height:520px;background:radial-gradient(circle,rgba(124,58,237,.20),rgba(255,0,110,.10) 50%,transparent 72%);pointer-events:none}
  .historia-grid{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:52px;align-items:center}
  .historia-foto{flex:1 1 380px;max-width:440px;position:relative;border-radius:18px;overflow:hidden;border:1px solid var(--line);box-shadow:0 30px 60px rgba(0,0,0,.5)}
  .historia-copy{flex:1 1 420px}
  .historia-foto img{width:100%;display:block}
  .historia-foto:before{content:"";position:absolute;inset:0;border-radius:18px;padding:1px;background:var(--grad);-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:.7;pointer-events:none}
  .historia-copy .eyebrow{display:block;margin-bottom:16px}
  .historia-quote{font-family:'Cormorant Garamond',serif;font-size:clamp(24px,3vw,32px);font-weight:600;line-height:1.28;color:#fff}
  .historia-quote .gradiente{font-style:italic}
  .historia-copy p.sub-copy{color:var(--muted);font-size:15px;line-height:1.7;margin-top:22px}
  .historia-firma{margin-top:24px;display:flex;align-items:center;gap:12px}
  .historia-firma .linea-mini{width:34px;height:2px;background:var(--grad);border-radius:2px}
  .historia-firma span{font-size:13px;color:var(--text);font-weight:600}

  /* ---------- FRASE DE IMPACTO ---------- */
  .impacto{padding:100px 0;text-align:center;position:relative;overflow:hidden}
  .impacto-glow{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:900px;height:420px;background:radial-gradient(circle,rgba(255,0,110,.18),rgba(124,58,237,.12) 45%,transparent 72%);pointer-events:none}
  .impacto>*{position:relative;z-index:1}
  .impacto .eyebrow{display:block;margin-bottom:22px}
  .impacto p{font-family:'Cormorant Garamond',serif;font-weight:600;font-style:italic;font-size:clamp(26px,4.2vw,44px);line-height:1.32;max-width:800px;margin:0 auto;color:#fff}
  .impacto p .gradiente{font-style:italic}

  /* ---------- URGENCIA ---------- */
  .urgencia{max-width:640px;margin:0 auto 22px;display:flex;align-items:center;gap:10px;justify-content:center;background:rgba(255,0,110,.08);border:1px solid rgba(255,0,110,.35);border-radius:100px;padding:10px 20px;font-size:12.5px;color:#fff}
  .urgencia .dot{width:7px;height:7px;border-radius:50%;background:var(--fucsia);flex-shrink:0;animation:pulse 1.6s infinite}
  @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.75)}}

  /* ---------- TESTIMONIOS (listos, sin inventar nada) ---------- */
  .testimonios{padding:80px 0 20px}
  .test-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:36px}
  .test-card{border:1px dashed var(--line);border-radius:14px;padding:24px 22px;text-align:center;color:var(--muted)}
  .test-card .avatar{width:38px;height:38px;border-radius:50%;border:1px dashed var(--line);margin:0 auto 14px;display:flex;align-items:center;justify-content:center;font-size:15px;color:var(--muted)}
  .test-card p{font-size:13px;line-height:1.6}
  .test-cta{text-align:center;margin-top:8px}
  .test-cta a{color:var(--cyan);font-size:13px;text-decoration:none;border-bottom:1px dashed rgba(0,212,255,.4)}

  @media (max-width:760px){
    .historia-grid{grid-template-columns:1fr;gap:30px}
    .test-grid{grid-template-columns:1fr}
  }

  /* ---------- ABOUT ---------- */
  .about{padding:70px 0 96px;border-top:1px solid var(--line)}
  .about-inner{max-width:640px;margin:0 auto;text-align:center}
  .about p{color:var(--muted);font-size:15.5px;line-height:1.7;margin-top:16px}
  .about .quote{margin-top:26px;font-family:'Cormorant Garamond',serif;font-size:21px;font-style:italic;color:#fff;line-height:1.4}

  /* ---------- FOOTER ---------- */
  footer{border-top:1px solid var(--line);padding:36px 0;text-align:center}
  footer p{color:var(--muted);font-size:12px}
  footer .brand{display:block;margin-bottom:10px;justify-content:center}

  @media (max-width:760px){
    .cards3{grid-template-columns:1fr}
    .ind-row{grid-template-columns:1fr}
    .bonos-grid{grid-template-columns:1fr;gap:20px}
    .stack{transform:scale(.85)}
    .price-card{padding:34px 22px}
  }
</style>
</head>
